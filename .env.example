# Hosted values must be set through Sites environment-variable tools.
# Comma-separated stable Sites user IDs allowed to administer QuickBuilding.
ADMIN_USER_IDS=
# Optional explicit verified identity emails for initial handover.
# Prefer stable user IDs once the administrator has signed in.
ADMIN_EMAILS=
# Empty allowlists deny admin access to every account.
# Local preview only: add ADMIN_USER_IDS=local_seedy to ignored .dev.vars.
